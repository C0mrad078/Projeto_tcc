# Copie este arquivo para .env e preencha os valores.
# USER_*_API1_* e USER_*_API5_* são preenchidos automaticamente por
# setup_vapi_users.py depois que o vAPI estiver rodando.
#
# IDENTITY_STRATEGY controla como Config.identity() resolve credenciais
# (ver agent/adapters.py): "per_module" (default, o que o vAPI precisa —
# cada módulo tem sua própria base de usuários) ou "shared" (um par de
# credenciais só, reaproveitado em qualquer módulo — mais simples, para um
# alvo hipotético com uma única base de usuários).
IDENTITY_STRATEGY=per_module
#
# IMPORTANTE: API1 e API5 são tabelas de usuários completamente separadas no
# vAPI (a_p_i1_users / a_p_i5_users) — "Usuário A" precisa de credenciais e
# ID PRÓPRIOS em cada módulo, não é a mesma conta reaproveitada.

# Porta 8000 no host, mapeada para a porta 80 do container (docker-compose.yml do vAPI).
TARGET_BASE_URL=http://localhost:8000/vapi

# Cabeçalho de autenticação customizado do vAPI: base64(username:senha).
AUTH_HEADER_NAME=Authorization-Token
AUTH_HEADER_FORMAT={token}

USER_A_API1_USERNAME=
USER_A_API1_PASSWORD=
USER_A_API1_ID=
USER_A_API1_TOKEN=

USER_B_API1_USERNAME=
USER_B_API1_PASSWORD=
USER_B_API1_ID=
USER_B_API1_TOKEN=

USER_A_API5_USERNAME=
USER_A_API5_PASSWORD=
USER_A_API5_ID=
USER_A_API5_TOKEN=

USER_B_API5_USERNAME=
USER_B_API5_PASSWORD=
USER_B_API5_ID=
USER_B_API5_TOKEN=

# Chave do Google AI Studio (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_S=30

# Modo experimental (ver README, "Arquitetura híbrida" / "Modos experimentais"):
#   heuristic -> LLM nunca é chamado.
#   hybrid    -> RECOMENDADO. Heurística decide os casos claros; LLM só desempata ambiguidade.
#   llm       -> experimental: força reavaliação por LLM de TUDO, mesmo o que a heurística já resolveria.
AGENT_MODE=hybrid

# USE_LLM_FOR_RELATION_INFERENCE / USE_LLM_FOR_CLASSIFICATION: mantidos por
# compatibilidade com versões anteriores a AGENT_MODE — são derivados dele
# quando ausentes. Uso avançado/depuração; prefira AGENT_MODE.
USE_LLM_FOR_RELATION_INFERENCE=true
USE_LLM_FOR_CLASSIFICATION=true

REQUEST_TIMEOUT_S=10
REQUEST_DELAY_MS=150
