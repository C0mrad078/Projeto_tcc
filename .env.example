# Copie este arquivo para .env e preencha os valores.
# USER_A_* e USER_B_* são preenchidos automaticamente por setup_vapi_users.py
# depois que o vAPI estiver rodando (ver README do roteiro do TCC).

TARGET_BASE_URL=http://localhost/vapi

# Cabeçalho de autenticação customizado do vAPI (módulo API1/API5):
# não é "Authorization: Bearer <token>", é um header próprio contendo
# base64(email:senha).
AUTH_HEADER_NAME=Authorization-Token
AUTH_HEADER_FORMAT={token}

USER_A_EMAIL=
USER_A_PASSWORD=
USER_A_ID=
USER_A_TOKEN=

USER_B_EMAIL=
USER_B_PASSWORD=
USER_B_ID=
USER_B_TOKEN=

# ANTHROPIC_API_KEY pode ficar em branco se você já autenticou via `ant auth login`.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
USE_LLM_FOR_RELATION_INFERENCE=true
USE_LLM_FOR_CLASSIFICATION=true

REQUEST_TIMEOUT_S=10
REQUEST_DELAY_MS=150
